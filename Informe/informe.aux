\@writefile{lof}{\contentsline {figure}{\numberline {67}{\ignorespaces SFC del programa \texttt  {NIVEL\_1} en CODESYS\spacefactor \@m {}. El step inicial \texttt  {Supervisory\_Control} habilita, mediante transición \texttt  {true}, una rama AND que activa en paralelo los macropasos \texttt  {Heartbeat\_Generator} y \texttt  {Supervisory\_Control}, los cuales permanecen activos de forma concurrente durante toda la operación. La rama OR con transición \texttt  {false} y acción \texttt  {Supervisory\_Control\_Init} provee el camino de salida requerido por IEC~61131-3 para conformidad del compilador.}}{96}{figure.67}\protected@file@percent }
\newlabel{fig:nivel1-sfc-top}{{67}{96}{SFC del programa \texttt {NIVEL\_1} en CODESYS\@. El step inicial \texttt {Supervisory\_Control} habilita, mediante transición \texttt {true}, una rama AND que activa en paralelo los macropasos \texttt {Heartbeat\_Generator} y \texttt {Supervisory\_Control}, los cuales permanecen activos de forma concurrente durante toda la operación. La rama OR con transición \texttt {false} y acción \texttt {Supervisory\_Control\_Init} provee el camino de salida requerido por IEC~61131-3 para conformidad del compilador}{figure.67}{}}
