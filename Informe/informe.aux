\@writefile{lof}{\contentsline {figure}{\numberline {69}{\ignorespaces Macropaso \texttt  {Supervisory\_Control} del programa \texttt  {NIVEL\_1}. El step \texttt  {OFF} inicializa las variables de control y alarma mediante acciones Reset/Set, y permanece activo hasta que se cumple \texttt  {P\_APN AND simulink\_started}. El macropaso \texttt  {ON} encapsula la lógica de operación normal y retorna incondicionalmente a \texttt  {OFF} al finalizar.}}{97}{figure.69}\protected@file@percent }
\newlabel{fig:nivel1-supervisory-top}{{69}{97}{Macropaso \texttt {Supervisory\_Control} del programa \texttt {NIVEL\_1}. El step \texttt {OFF} inicializa las variables de control y alarma mediante acciones Reset/Set, y permanece activo hasta que se cumple \texttt {P\_APN AND simulink\_started}. El macropaso \texttt {ON} encapsula la lógica de operación normal y retorna incondicionalmente a \texttt {OFF} al finalizar}{figure.69}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {70}{\ignorespaces Interior del macropaso \texttt  {ON}. Tras el step de inicialización \texttt  {ON\_Init}, una rama AND lanza en paralelo los macropasos \texttt  {Lidar\_Map}, \texttt  {BRK\_Logic}, \texttt  {Limit\_Switch}, \texttt  {Sway\_Control}, \texttt  {Trolley\_Movement}, \texttt  {Hoist\_Movement}, \texttt  {Mode}, \texttt  {TLK\_Logic} y \texttt  {Trajectory}, ejecutándose todos de forma concurrente. La rama AND finaliza con la transición \texttt  {NOT P\_APN OR emgy}, que retorna el control al step \texttt  {OFF}.}}{97}{figure.70}\protected@file@percent }
\newlabel{fig:nivel1-supervisory-on}{{70}{97}{Interior del macropaso \texttt {ON}. Tras el step de inicialización \texttt {ON\_Init}, una rama AND lanza en paralelo los macropasos \texttt {Lidar\_Map}, \texttt {BRK\_Logic}, \texttt {Limit\_Switch}, \texttt {Sway\_Control}, \texttt {Trolley\_Movement}, \texttt {Hoist\_Movement}, \texttt {Mode}, \texttt {TLK\_Logic} y \texttt {Trajectory}, ejecutándose todos de forma concurrente. La rama AND finaliza con la transición \texttt {NOT P\_APN OR emgy}, que retorna el control al step \texttt {OFF}}{figure.70}{}}
