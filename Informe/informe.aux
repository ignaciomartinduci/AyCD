\@writefile{lof}{\contentsline {figure}{\numberline {72}{\ignorespaces Macropaso \texttt  {BRK\_Logic}: rama AND que ejecuta en paralelo los macropasos \texttt  {BRK\_t\_Logic} y \texttt  {BRK\_h\_Logic}, uno por cada accionamiento.}}{98}{figure.72}\protected@file@percent }
\newlabel{fig:nivel1-brk-top}{{72}{98}{Macropaso \texttt {BRK\_Logic}: rama AND que ejecuta en paralelo los macropasos \texttt {BRK\_t\_Logic} y \texttt {BRK\_h\_Logic}, uno por cada accionamiento}{figure.72}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {73}{\ignorespaces Interior del macropaso \texttt  {BRK\_t\_Logic}. El step \texttt  {BRK\_t\_Closed} mantiene el freno aplicado (\texttt  {R BRK\_t\_nvl\_1}) hasta que la posición estimada del carro se encuentra dentro de la zona segura y no hay fin de carrera activo, condición bajo la cual se habilita la apertura (\texttt  {BRK\_t\_Opened}, \texttt  {S BRK\_t\_nvl\_1}). El freno se vuelve a aplicar si la velocidad supera el umbral \texttt  {w\_tm\_min\_BRK} con un fin de carrera activo, retornando a \texttt  {BRK\_t\_Closed}. La rama OR con \texttt  {NOT P\_APN} provee el camino de salida del macropaso. El caso del izaje (\texttt  {BRK\_h\_Logic}) es enteramente análogo.}}{98}{figure.73}\protected@file@percent }
\newlabel{fig:nivel1-brk-t}{{73}{98}{Interior del macropaso \texttt {BRK\_t\_Logic}. El step \texttt {BRK\_t\_Closed} mantiene el freno aplicado (\texttt {R BRK\_t\_nvl\_1}) hasta que la posición estimada del carro se encuentra dentro de la zona segura y no hay fin de carrera activo, condición bajo la cual se habilita la apertura (\texttt {BRK\_t\_Opened}, \texttt {S BRK\_t\_nvl\_1}). El freno se vuelve a aplicar si la velocidad supera el umbral \texttt {w\_tm\_min\_BRK} con un fin de carrera activo, retornando a \texttt {BRK\_t\_Closed}. La rama OR con \texttt {NOT P\_APN} provee el camino de salida del macropaso. El caso del izaje (\texttt {BRK\_h\_Logic}) es enteramente análogo}{figure.73}{}}
