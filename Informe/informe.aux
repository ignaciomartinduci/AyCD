\@writefile{lof}{\contentsline {figure}{\numberline {67}{\ignorespaces Árbol de proyecto \texttt  {CODESYS\_PF\_AYCD}. Bajo \textit  {Application} se agrupan las variables globales (\texttt  {GVL}), las funciones auxiliares (\texttt  {estimar\_masa}, \texttt  {rate\_limiter}, \texttt  {signo\_real}, \texttt  {xpos2ypos}), los bloques de función de generación de trayectorias (\texttt  {generador\_trayectoria}, \texttt  {generador\_trayectoria\_izaje}), y las POU tipo \textit  {Programa} \texttt  {NIVEL\_0} y \texttt  {NIVEL\_1} (cada una con acciones internas). La \textit  {Configuración de símbolos} habilita la interfaz OPC~UA\spacefactor \@m {}. En \textit  {Configuración de tareas}, \texttt  {MainTask} ejecuta cíclicamente ambos programas.}}{93}{figure.67}\protected@file@percent }
\newlabel{fig:codesys_estructura}{{67}{93}{Árbol de proyecto \texttt {CODESYS\_PF\_AYCD}. Bajo \textit {Application} se agrupan las variables globales (\texttt {GVL}), las funciones auxiliares (\texttt {estimar\_masa}, \texttt {rate\_limiter}, \texttt {signo\_real}, \texttt {xpos2ypos}), los bloques de función de generación de trayectorias (\texttt {generador\_trayectoria}, \texttt {generador\_trayectoria\_izaje}), y las POU tipo \textit {Programa} \texttt {NIVEL\_0} y \texttt {NIVEL\_1} (cada una con acciones internas). La \textit {Configuración de símbolos} habilita la interfaz OPC~UA\@. En \textit {Configuración de tareas}, \texttt {MainTask} ejecuta cíclicamente ambos programas}{figure.67}{}}
