\newlabel{subsec:codesys-nivel0}{{4.2}{96}{Nivel 0: Seguridad y Protección}{subsection.4.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {68}{\ignorespaces SFC del programa \texttt  {NIVEL\_0} en CODESYS\spacefactor \@m {}. El step inicial \texttt  {Safety\_Secu\-rity} inicializa mediante acciones Reset/Set las variables de diagnóstico (\texttt  {watchdog\_fa\-iled}, \texttt  {heart\-beat\_pre\-sent}, \texttt  {hoist\_sol\-ved}, \texttt  {trol\-ley\_sol\-ved}). La transición \texttt  {TRUE AND simulink\_started} habilita una rama AND que lanza en paralelo los pasos \texttt  {Watchdog} y \texttt  {Emergencies}, manteniendo ambas lógicas activas de forma concurrente durante toda la operación. Ante una condición \texttt  {FALSE}, se ejecuta la acción \texttt  {Safety\_Security\_Init} que reinicializa el nivel.}}{96}{figure.68}\protected@file@percent }
\newlabel{fig:nivel0-sfc-top}{{68}{96}{SFC del programa \texttt {NIVEL\_0} en CODESYS\@. El step inicial \texttt {Safety\_Secu\-rity} inicializa mediante acciones Reset/Set las variables de diagnóstico (\texttt {watchdog\_fa\-iled}, \texttt {heart\-beat\_pre\-sent}, \texttt {hoist\_sol\-ved}, \texttt {trol\-ley\_sol\-ved}). La transición \texttt {TRUE AND simulink\_started} habilita una rama AND que lanza en paralelo los pasos \texttt {Watchdog} y \texttt {Emergencies}, manteniendo ambas lógicas activas de forma concurrente durante toda la operación. Ante una condición \texttt {FALSE}, se ejecuta la acción \texttt {Safety\_Security\_Init} que reinicializa el nivel}{figure.68}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {69}{\ignorespaces Macropaso \texttt  {Watchdog} del programa \texttt  {NIVEL\_0}. Su funcionamiento es análogo al descrito para el estado homónimo en el Statechart de Stateflow (sección~\ref {sec:emergencies}). Las acciones \texttt  {ResetCounter}, \texttt  {UpdateHeartbeat} e \texttt  {IncreaseCounter} están implementadas en ST como acciones asociadas a los pasos de esta POU\spacefactor \@m {}. Al final del macropaso se incorpora una rama OR con transición \texttt  {false} hacia el step \texttt  {Watchdog\_Exit}, recurso requerido por IEC~61131-3 para que el compilador acepte el diagrama SFC como conforme a la norma.}}{97}{figure.69}\protected@file@percent }
\newlabel{fig:nivel0-watchdog}{{69}{97}{Macropaso \texttt {Watchdog} del programa \texttt {NIVEL\_0}. Su funcionamiento es análogo al descrito para el estado homónimo en el Statechart de Stateflow (sección~\ref {sec:emergencies}). Las acciones \texttt {ResetCounter}, \texttt {UpdateHeartbeat} e \texttt {IncreaseCounter} están implementadas en ST como acciones asociadas a los pasos de esta POU\@. Al final del macropaso se incorpora una rama OR con transición \texttt {false} hacia el step \texttt {Watchdog\_Exit}, recurso requerido por IEC~61131-3 para que el compilador acepte el diagrama SFC como conforme a la norma}{figure.69}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {70}{\ignorespaces Macropaso \texttt  {Emergencies} del programa \texttt  {NIVEL\_0}, análogo al diseño de Stateflow de la sección~\ref {sec:emergencies}. La acción \texttt  {LVL1PASS}, con calificador~\texttt  {N} en el step \texttt  {Stand\_By}, permite el paso de las consignas provenientes del Nivel~1 (\texttt  {BRK\_t}, \texttt  {BRK\_h}, \texttt  {v\_t\_ref}, \texttt  {x\_t\_ref}, \texttt  {dl\_h\_ref}, \texttt  {l\_h\_ref}, \texttt  {sway\_ctr\_enable}) mientras no haya falla activa. Las acciones \texttt  {ResetTrolleyRef} y \texttt  {ResetHoistRef}, activadas ante emergencia, sustituyen dichas consignas por velocidades nulas y referencias de posición iguales al valor actual del sensor o estimación, de modo que no induzcan movimiento sobre el eje afectado. Las tres acciones están implementadas en ST dentro de esta POU\spacefactor \@m {}.}}{98}{figure.70}\protected@file@percent }
\newlabel{fig:nivel0-emergencias}{{70}{98}{Macropaso \texttt {Emergencies} del programa \texttt {NIVEL\_0}, análogo al diseño de Stateflow de la sección~\ref {sec:emergencies}. La acción \texttt {LVL1PASS}, con calificador~\texttt {N} en el step \texttt {Stand\_By}, permite el paso de las consignas provenientes del Nivel~1 (\texttt {BRK\_t}, \texttt {BRK\_h}, \texttt {v\_t\_ref}, \texttt {x\_t\_ref}, \texttt {dl\_h\_ref}, \texttt {l\_h\_ref}, \texttt {sway\_ctr\_enable}) mientras no haya falla activa. Las acciones \texttt {ResetTrolleyRef} y \texttt {ResetHoistRef}, activadas ante emergencia, sustituyen dichas consignas por velocidades nulas y referencias de posición iguales al valor actual del sensor o estimación, de modo que no induzcan movimiento sobre el eje afectado. Las tres acciones están implementadas en ST dentro de esta POU\@}{figure.70}{}}
